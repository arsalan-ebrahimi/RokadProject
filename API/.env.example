# ==============================================================================
# Rokad API - Environment Variables Template
# Copy this file to config.env and fill in your production/staging values.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
DATA_BASE=mongodb://127.0.0.1:27017/RokadProject

# Authentication Secrets
# Mandatory: Generate a high-entropy secret in production (e.g., openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_here

# Third-party Integrations
SMS_KEY=your_sms_gateway_api_key_here

# CORS Configuration
# Comma-separated list of allowed origins (never '*' in production when credentials are used)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Proxy Trust
# Number of reverse proxy hops (e.g. 1 for single Nginx/Traefik reverse proxy, or specific CIDR)
TRUST_PROXY=1

# Rate Limiting Tiers (Max requests per 15-minute window)
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=1000

RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

RATE_LIMIT_WRITE_WINDOW_MS=900000
RATE_LIMIT_WRITE_MAX=300

RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=60

RATE_LIMIT_PREVIEW_WINDOW_MS=900000
RATE_LIMIT_PREVIEW_MAX=100

# File Upload Limits (in bytes, e.g. 5242880 = 5MB)
MAX_UPLOAD_SIZE_BYTES=5242880
